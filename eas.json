{
  "cli": {
    "version": ">= 10.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-store": {
      "channel": "preview",
      "distribution": "store",
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PERSONAL_AUTH_STAGE": "production",
        "EXPO_PUBLIC_GOOGLE_LOGIN_ENABLED": "true"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview-store": {
      "ios": {
        "ascAppId": "6825692888"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6825692888"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
