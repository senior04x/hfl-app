{
  "expo": {
    "name": "amatora",
    "slug": "amatora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "hflsoccerapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amatora.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Profil va jamoa logotipini rasmga olish uchun kameradan foydalaniladi.",
        "NSPhotoLibraryUsageDescription": "Profil va jamoa rasmlarini yuklash uchun rasm galereyasiga kirish so'raladi."
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#121212",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#000000"
        }
      }
    },
    "android": {
      "package": "com.amatora.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#000000"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "notification": {
      "icon": "./assets/images/app-icon.png",
      "color": "#00DF82"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#00DF82"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {},
    "extra": {
      "eas": {
        "projectId": "14fddb89-af52-47b3-90ab-f437d786254b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/14fddb89-af52-47b3-90ab-f437d786254b",
      "enabled": true,
      "checkOnLaunch": "ALWAYS"
    }
  }
}
