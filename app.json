{
  "expo": {
    "name": "amatora",
    "slug": "amatora",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "hflsoccerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amatora.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Profil va jamoa logotipini rasmga olish uchun kameradan foydalaniladi.",
        "NSPhotoLibraryUsageDescription": "Profil va jamoa rasmlarini yuklash uchun rasm galereyasiga kirish so'raladi."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.amatora.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#E85002"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save your goal videos to your gallery.",
          "granularPermissions": []
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-video",
      "expo-apple-authentication"
    ],
    "experiments": {},
    "extra": {
      "eas": {
        "projectId": "14fddb89-af52-47b3-90ab-f437d786254b"
      }
    },
    "runtimeVersion": "sdk58-local-test",
    "updates": {
      "url": "https://u.expo.dev/14fddb89-af52-47b3-90ab-f437d786254b",
      "enabled": true
    }
  }
}
